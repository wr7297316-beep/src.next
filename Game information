(function() {
    console.log("%c [!] INITIATING BYPASS: STAGE 1 -> STAGE 2 ", "color: gold; background: #000; font-weight: bold;");

    // 1. Manually flip the internal flags found in the index.js
    window.T3_Stage = 2;
    window.Hydration = true;
    window.countdown_timer = false;

    // 2. Force reveal any hidden video or luxury asset containers
    const selectors = ['#t3-frame', '.preorder-overlay', '.rolex-watch-asset', '.trailer-player'];
    selectors.forEach(selector => {
        const el = document.querySelector(selector);
        if (el) {
            el.style.display = 'block';
            el.style.visibility = 'visible';
            el.style.opacity = '1';
            console.log("Revealed component: " + selector);
        }
    });

    // 3. Search for the hidden mp4 link in the page memory
    const scripts = document.getElementsByTagName('script');
    const regex = /https?:\/\/[^\s"'<>]+\.(mp4|m3u8|webm)/g;
    
    for (let i = 0; i < scripts.length; i++) {
        const found = scripts[i].innerHTML.match(regex);
        if (found) {
            console.log("%c FOUND HIDDEN VIDEO: ", "color: #00ff00;", found);
        }
    }
})();
